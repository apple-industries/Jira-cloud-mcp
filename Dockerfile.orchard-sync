# Orchard -> Jira reference-data sync (scripts/orchard_jira_sync.py) for beta-lab.
# Nightly job: upserts Assets Content Codes + Products (ORCH schema) from the Orchard
# BI replica. Stdlib-only Python but shells out to `psql`, so the image adds the
# postgres client. Build context = repo root.
#
#   docker build -f Dockerfile.orchard-sync --platform linux/arm64 -t <ecr>:latest .
#
# Runtime env (injected by the beta-lab task def): JIRA_EMAIL, JIRA_API_TOKEN,
# ASSETS_WORKSPACE_ID, ADMIN_DB_URL (+ JIRA_URL for the future org-operator module).
# Default command applies content-codes + products; org-operator is deferred until the
# Back Office field exists (BO_ORG_OPERATOR_FIELD_ID). Drop --apply to dry-run.
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV PYTHONUNBUFFERED=1

# HERE=/app/scripts, so orch-schema.json sits beside the script (its first lookup path).
COPY scripts/orchard_jira_sync.py scripts/sync_backoffice_org_operator.py scripts/orch-schema.json ./scripts/

CMD ["python", "scripts/orchard_jira_sync.py", "--only", "content-codes,products", "--apply"]
