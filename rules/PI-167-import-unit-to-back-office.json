{
  "rule": {
    "name": "Import Unit to Back Office (manual)",
    "state": "DISABLED",
    "description": "PI-167. Manual action on a Software Setup (CUSTSVC / PM Clark) issue: OAuth to Orchard, branch to the linked EPRO Unit Setup for org/operator/content, POST /v1/units/import, then comment the result. Create DISABLED; validate by round-trip (GET) before enabling.",
    "trigger": {
      "component": "TRIGGER",
      "schemaVersion": 3,
      "type": "jira.manual.trigger.issue",
      "value": {
        "inputFromUsers": false,
        "inputPrompts": [],
        "groups": [],
        "issueFilter": { "filterType": "JQL", "value": "project = CUSTSVC AND component = \"PM Clark\"" },
        "jQLFilter": null
      }
    },
    "components": [
      {
        "component": "CONDITION",
        "schemaVersion": 1,
        "type": "jira.jql.condition",
        "value": { "rawJql": "\"Serial Number\" is not EMPTY AND \"Computer HDID\" is not EMPTY" },
        "children": [],
        "conditions": []
      },
      {
        "component": "ACTION",
        "schemaVersion": 1,
        "type": "jira.issue.outgoing.webhook",
        "value": {
          "url": "https://idp.v1.orchard.fpphoto.io/v1/oauth/token",
          "headers": [
            { "name": "Content-Type", "value": "application/json", "headerSecure": false },
            { "name": "accept", "value": "application/json", "headerSecure": false },
            { "name": "Authorization", "value": "Basic <<ORCHARD_BASIC_AUTH_TOKEN>>", "headerSecure": true }
          ],
          "sendIssue": false,
          "contentType": "custom",
          "customBody": "{ \"grant_type\": \"client_credentials\" }",
          "method": "POST",
          "responseEnabled": true,
          "continueOnErrorEnabled": false
        },
        "children": [],
        "conditions": []
      },
      {
        "component": "ACTION",
        "schemaVersion": 1,
        "type": "jira.create.variable",
        "value": {
          "name": { "type": "FREE", "value": "token" },
          "type": "SMART",
          "query": { "type": "SMART", "value": "{{webResponse.body.access_token}}" },
          "lazy": false
        },
        "children": [],
        "conditions": []
      },
      {
        "component": "BRANCH",
        "schemaVersion": 1,
        "type": "jira.issue.related",
        "value": {
          "relatedType": "linked",
          "jql": "issuetype = \"Unit Setup\"",
          "linkTypes": ["is a prerequisite of", "depends on"],
          "onlyUpdatedIssues": false
        },
        "conditions": [],
        "children": [
          {
            "component": "CONDITION",
            "schemaVersion": 1,
            "type": "jira.jql.condition",
            "value": { "rawJql": "\"Back Office Organization\" is not EMPTY AND \"Back Office Operator\" is not EMPTY AND \"Photo Booth Product\" is not EMPTY" },
            "children": [],
            "conditions": []
          },
          {
            "component": "ACTION",
            "schemaVersion": 1,
            "type": "jira.issue.outgoing.webhook",
            "value": {
              "url": "https://unit.v1.orchard.fpphoto.io/v1/units/import",
              "headers": [
                { "name": "Content-Type", "value": "application/json", "headerSecure": false },
                { "name": "accept", "value": "application/json", "headerSecure": false },
                { "name": "Authorization", "value": "Bearer {{token}}", "headerSecure": false }
              ],
              "sendIssue": false,
              "contentType": "custom",
              "customBody": "[{ \"organization\": \"{{issue.Back Office Organization}}\", \"operator\": \"{{issue.Back Office Operator}}\", \"serial_number\": \"{{triggerIssue.Serial Number}}\", \"hdid\": { \"hard_drive_id\": \"{{triggerIssue.Computer HDID}}\", \"start_datetime\": \"{{now.toIso8601}}\" }, \"product_code\": \"{{triggerIssue.Serial Number.substring(triggerIssue.Serial Number.length.minus(3))}}\", \"nickname\": \"{{triggerIssue.Serial Number}}\" }]",
              "method": "POST",
              "responseEnabled": true,
              "continueOnErrorEnabled": true
            },
            "children": [],
            "conditions": []
          },
          {
            "component": "ACTION",
            "schemaVersion": 2,
            "type": "jira.issue.comment",
            "value": {
              "comment": "{{#if(equals(webResponse.status, 204))}}Unit {{triggerIssue.Serial Number}} imported to Back Office.{{/}}{{#if(equals(webResponse.status, 400))}}Import failed for {{triggerIssue.Serial Number}}: {{webResponse.body}}{{/}}",
              "publicComment": false,
              "sendNotifications": true,
              "addCommentOnce": false
            },
            "children": [],
            "conditions": []
          }
        ]
      }
    ]
  },
  "connections": {}
}
